# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/

# ---- ML / experiment artifacts ----
wandb/                    # local W&B run cache — never commit this
*.ckpt                    # model checkpoints (large, regenerable)
*.pth
*.pt
lightning_logs/
content/models/           # the notebook's local checkpoint dir (cell 19)
outputs/
*.log

# ---- Data (do NOT commit the dataset) ----
data/
*.nii                     # dermoscopy images live on Kaggle, not in git
*.nii.gz
*.csv                     # unless a small results table you *want* tracked
*.zip

# ---- Secrets (critical) ----
.env
*.key
wandb_api_key*
kaggle.json               # Kaggle API credentials — NEVER commit

# ---- OS / editor cruft ----
.DS_Store                 # you're on macOS — this one matters
Thumbs.db
.vscode/
.idea/
